        }
      ],
      "out": [
        {
          "id": "HARDCODED_SECRET",
          "file": "a.js",
          "line": 1,
          "evidence": "const pwd = \"letm****\";"
        },
        {
          "id": "HARDCODED_IP",
          "file": "b.js",
          "line": 1,
          "evidence": "const ip = \"10.1.2.3\";"
        }
      ]
    },
    {
      "name": "a token shape is masked in every finding, even outside quotes",
